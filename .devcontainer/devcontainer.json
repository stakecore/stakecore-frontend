{
	"name": "${localWorkspaceFolderBasename}",
    "dockerComposeFile": "docker-compose.yaml",
    "service": "dev",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "22"
        }
    },
    "postCreateCommand": ".devcontainer/post-create.sh",
    "initializeCommand": ".devcontainer/initialize.sh",
    // Let Corepack download the pinned pnpm without the interactive y/n
    // prompt, so post-create.sh's non-interactive `pnpm install` doesn't
    // hang waiting on stdin.
    "containerEnv": {
        "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
    },
    // 5173 / 4173 / 53770-53779 are published straight to the host by
    // docker-compose.yaml, so they are deliberately absent from
    // forwardPorts — VS Code would try to bind the same host port a second
    // time, fail, and silently land on a neighbouring one, which is more
    // confusing than no entry at all. Labels still apply to auto-detected
    // ports, so the two published app ports get named in the Ports view
    // without being forwarded twice.
    "portsAttributes": {
        "5173": { "label": "vite dev", "onAutoForward": "silent" },
        "4173": { "label": "vite preview (e2e target)", "onAutoForward": "silent" }
    },
    // Anything outside those blocks — an ad-hoc tool that picked its own
    // port — is not published, so the editor's forwarding is the only way
    // in. Notify rather than forward silently, or a server that started
    // fine looks unreachable.
    "otherPortsAttributes": { "onAutoForward": "notify" },
    "customizations": {
        "vscode": {
            "extensions": [
                "mikestead.dotenv",
                "eamodio.gitlens",
                "usernamehw.errorlens",
                "christian-kohler.path-intellisense",
                "gruntfuggly.todo-tree",
                "pkief.material-icon-theme",
                "editorconfig.editorconfig",
                "redhat.vscode-yaml",
                "timonwong.shellcheck",
                "anthropic.claude-code",
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint"
            ],
            "settings": {
                // Todo Tree only looks for ripgrep under VS Code's appRoot and
                // never on PATH, so it can't find the copy post-create.sh
                // installs unless we point it there explicitly.
                "todo-tree.ripgrep": "/usr/bin/rg",
                "editor.insertSpaces": true,
                "editor.detectIndentation": false,
                "files.trimFinalNewlines": true,
                "files.trimTrailingWhitespace": true,
                "[typescript]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode",
                    "editor.tabSize": 2
                },
                "[javascript]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode",
                    "editor.tabSize": 2
                },
                "[json]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode",
                    "editor.tabSize": 2
                },
                "[jsonc]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode",
                    "editor.tabSize": 2
                },
                "[markdown]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                }
            }
        }
    }
}
